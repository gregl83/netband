+impl WireMeasurement {
+    fn upload(self) -> Option<UploadMeasurement> {
+        if self
+            .origin
+            .as_deref()
+            .is_some_and(|origin| origin != "server")
+            || self.test.as_deref().is_some_and(|test| test != "upload")
+        {
+            return None;
+        }
+        let tcp = self.tcp_info?;
+        let bytes = tcp.bytes_received?;
+        let micros = tcp.elapsed_time?;
+        (bytes > 0 && micros > 0).then_some(UploadMeasurement {
+            bytes,
+            elapsed: Duration::from_micros(micros),
+        })
+    }
+}
